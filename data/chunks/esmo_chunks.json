      "gor": "D",
      "esmo_mcbs": null,
      "escat": null
    },
    "superseded_by": null,
    "copyright_notice": "Copyright © European Society for Medical Oncology. All rights reserved"
  },
  {
    "schema_version": "0.1-draft",
    "chunk_id": "esmo-ebc-2024-02-tnbc-r10",
    "doc_type": "guideline",
    "source": "ESMO-EBC",
    "version": "2024-02",
    "section": "TNBC",
    "page_start": null,
    "page_end": null,
    "url": "https://doi.org/10.1016/j.annonc.2023.11.016",
    "chunk_kind": "recommendation",
    "parent_id": null,
    "text": "In patients with gBRCA1/2m and high-risk TNBC (nonpCR or pathological stage II-III), 1 year of adjuvant olaparib should be administered [I, A; ESMO-MCBS v1.1 score: A; ESCAT: I-A].",
