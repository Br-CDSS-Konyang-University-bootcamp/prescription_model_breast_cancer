{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "confirmed_state.json",
  "title": "confirmed_state",
  "description": "화면 1에서 의사가 확정한 환자 상태. 2단계(C 지침 검색, D 급여, [4] LLM 추천)는 items.*.confirmed만 읽는다. 설계: notes/confirmed_state_items_2026-10-21.md §5·§6. 초안 v0.1-draft (A 제안, 4명 검토 전). 2026-10-22 급여 조건용 선택 항목 추가 (cardiac_risk, mediastinal_radiation, visceral_crisis, contraindicated_classes, bone_metastasis_imaging, recent_therapy_28d, stage.size_mm, stage.n, operable, recurrence_day, metastasis_day, anthracycline_cumulative, prior_regimens의 progression_day·cycles·ongoing): 2단계가 이 파일 하나로 급여 조건을 판정할 수 있게 한다 (notes/virtual_chart_data_coverage_2026-10-22.md §5.2).",
  "type": "object",
  "required": ["schema_version", "patient_ref", "version", "visit_type", "decision_context", "index_day", "confirmed_at", "confirmed_by", "based_on", "supersedes", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1-draft"},
    "patient_ref": {"type": "string", "description": "가명 ID. patient_state.patient_ref와 같다"},
    "version": {"type": "integer", "minimum": 1, "description": "환자마다 1부터. 이전 버전은 지우지 않는다"},
    "visit_type": {"enum": ["initial", "follow_up"], "description": "같은 patient_ref의 이전 confirmed_state가 있으면 follow_up. 화면 모드(잠금 칸, 이전 값 비교)만 바꾼다"},
    "decision_context": {"enum": ["early", "metastatic"], "description": "확정된 setting.disease로 정한다: metastatic → metastatic, early·locally_advanced → early. 필수 항목이 이 값으로 갈린다"},
    "index_day": {"type": ["integer", "null"], "description": "판정 기준일 (진단일 = 0). patient_state.index_day를 옮긴다"},
    "confirmed_at": {"type": "string", "format": "date-time"},
    "confirmed_by": {"type": "string", "description": "가명 사용자 ID. 실명·면허번호는 넣지 않는다"},
    "based_on": {
      "type": "object",
      "required": ["patient_state_created_at", "biomarker_record_version"],
      "additionalProperties": false,
      "properties": {
        "patient_state_created_at": {"type": "string", "format": "date-time"},
        "biomarker_record_version": {"type": "string"}
      }
    },
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["version", "confirmed_at"],
          "additionalProperties": false,
          "properties": {
            "version": {"type": "integer", "minimum": 1},
            "confirmed_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "items": {"$ref": "#/$defs/items"},
    "visit_inputs": {
      "type": "object",
      "description": "재진 전용 입력. 진행 기록이 없는 차트를 의사가 보충한다",
      "additionalProperties": false,
      "properties": {
        "last_regimen_response": {"enum": ["CR", "PR", "SD", "PD", "unknown"]},
        "progression_date": {"type": ["string", "null"], "description": "YYYY-MM-DD"},
        "visit_reason": {"type": ["string", "null"]}
      }
    },
    "memo": {"type": "string", "description": "판단 근거 자유 기재"},
    "evidence": {
      "type": "array",
      "description": "메모 근거로 첨부한 원문 인용 (patient_state source와 같은 형식)",
      "items": {
        "type": "object",
        "required": ["item", "doc_id", "quote"],
        "additionalProperties": false,
        "properties": {
          "item": {"type": "string", "description": "items의 키. 예: subtype, markers.ER"},
          "doc_id": {"type": "string"},
          "quote": {"type": "string"},
          "char_start": {"type": ["integer", "null"]},
          "char_end": {"type": ["integer", "null"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision_context": {"const": "metastatic"}}},
      "then": {
        "properties": {"items": {
          "required": ["setting.line_endocrine", "setting.line_chemo", "prior_regimens", "metastatic_sites"],
          "properties": {"setting.disease": {"properties": {"confirmed": {"const": "metastatic"}}}}
        }}
      },
      "else": {
        "properties": {"items": {
          "required": ["setting.phase", "stage.t", "stage.positive_ln_count", "stage.group"],
          "properties": {"setting.disease": {"properties": {"confirmed": {"enum": ["early", "locally_advanced"]}}}}
        }}
      }
    },
    {
      "description": "HR+면 폐경 확정 필수 (내분비요법·CDK4/6 급여 조건)",
      "if": {"properties": {"items": {"properties": {"subtype": {"properties": {"confirmed": {"enum": ["HR+/HER2-", "HR+/HER2+"]}}}}}}},
      "then": {"properties": {"items": {"required": ["menopausal_status"]}}}
    },
    {
      "description": "전이성 HR+면 내분비 저항성 확정 필수 (ESMO M02/M03, 급여 3가/3다)",
      "if": {"properties": {
        "decision_context": {"const": "metastatic"},
        "items": {"properties": {"subtype": {"properties": {"confirmed": {"enum": ["HR+/HER2-", "HR+/HER2+"]}}}}}
      }},
      "then": {"properties": {"items": {"required": ["endocrine_relapse_12m"]}}}
    },
    {
      "description": "전이성 TNBC면 PD-L1과 DFI 확정 필수",
      "if": {"properties": {
        "decision_context": {"const": "metastatic"},
        "items": {"properties": {"subtype": {"properties": {"confirmed": {"const": "TNBC"}}}}}
      }},
      "then": {"properties": {"items": {"required": ["dfi_days"], "properties": {"markers": {"required": ["PD-L1"]}}}}}
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "description": "확정 항목 한 칸. confirmed의 허용 값은 항목마다 따로 정한다",
      "required": ["scope", "system", "system_source", "confirmed", "status"],
      "additionalProperties": false,
      "properties": {
        "scope": {"enum": ["diagnosis", "current"], "description": "diagnosis = 진단 시 고정 (재진에서 잠금), current = 방문마다 확인"},
        "system": {"description": "시스템 값 (A·B 출력 또는 계산값). 규칙이 없으면 null. B의 unknown 같은 판정 불가 값도 그대로 둔다"},
        "system_source": {"enum": ["patient_state", "biomarker_record", "derived"], "description": "derived = 두 JSON으로 화면이나 규칙 함수가 계산한 값"},
        "previous": {"description": "이전 버전의 confirmed (재진만)"},
        "confirmed": {"description": "의사가 확정한 값. 2단계는 이 값만 쓴다"},
        "detail": {"type": "object", "description": "판정의 숫자 근거. 예: Ki-67 {percent}, PD-L1 {assay, score_type, score}, ER {percent}"},
        "status": {"enum": ["confirmed", "changed", "carried", "unchanged", "corrected"], "description": "confirmed = 시스템 값 그대로 확정, changed = 시스템 값(또는 이전 값)과 다르게 확정, carried = 잠금 항목을 이전 버전에서 가져옴, unchanged = 재진에서 확인했고 이전과 같음, corrected = 잠금 항목을 의사가 고침"},
        "reason": {"type": "string", "description": "changed·corrected면 필수"},
        "note": {"type": "string"},
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["doc_id", "quote"],
            "additionalProperties": false,
            "properties": {
              "doc_id": {"type": "string"},
              "quote": {"type": "string"},
              "char_start": {"type": ["integer", "null"]},
              "char_end": {"type": ["integer", "null"]}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["changed", "corrected"]}}},
          "then": {"required": ["reason"]}
        },
        {
          "if": {"properties": {"status": {"enum": ["carried", "unchanged", "corrected"]}}},
          "then": {"required": ["previous"]}
        }
      ]
    },
    "gene_status": {"enum": ["positive", "negative", "vus", "not_done", "not_recorded"]},
    "cumulative_dose": {
      "description": "누적 용량 하나. 체표면적으로 바꾼 mg/m2 값, 또는 기록 없음",
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "unit"],
          "additionalProperties": false,
          "properties": {
            "value": {"type": "number", "minimum": 0},
            "unit": {"const": "mg/m2"}
          }
        },
        {"const": "not_recorded"}
      ]
    },
    "regimen": {
      "type": "object",
      "required": ["drugs", "subclasses", "setting", "response"],
      "additionalProperties": false,
      "properties": {
        "drugs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "일반명 소문자"},
        "subclasses": {"type": "array", "items": {"type": "string"}, "description": "data/dictionaries/drug_classes.csv의 drug_subclass. 없으면 drug_class"},
        "setting": {"enum": ["neoadjuvant", "adjuvant", "metastatic", "unknown"]},
        "start_day": {"type": ["integer", "null"]},
        "end_day": {"type": ["integer", "null"]},
        "line_endocrine": {"type": ["integer", "null"], "minimum": 1},
        "line_chemo": {"type": ["integer", "null"], "minimum": 1},
        "response": {"enum": ["CR", "PR", "SD", "PD", "unknown"]},
        "stop_reason": {"enum": ["progression", "toxicity", "completed", "planned_switch", "maintenance", "other", null]},
        "progression_day": {"type": ["integer", "null"], "description": "이 요법 중 또는 후 진행일 (진단일 = 0). '종료 후 1달 이내 진행' 조건 (2026-10-22 추가)"},
        "cycles": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["value", "interval_days"],
              "additionalProperties": false,
              "properties": {
                "value": {"type": "integer", "minimum": 0},
                "interval_days": {"type": ["integer", "null"], "minimum": 1}
              }
            }
          ],
          "description": "투여 주기 수와 주기 길이 (일). 총 trastuzumab 18주기 같은 조건. 매일 먹는 약은 null (2026-10-22 추가)"
        },
        "ongoing": {"type": ["boolean", "null"], "description": "기준일에 투약 중인지. true면 end_day는 null (2026-10-22 추가)"}
      }
    },
    "items": {
      "type": "object",
      "required": ["setting.disease", "subtype", "markers"],
      "additionalProperties": false,
      "properties": {
        "setting.disease": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["early", "locally_advanced", "metastatic"]}}}]},
        "setting.phase": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["neoadjuvant", "adjuvant"]}}}],
                          "description": "조기 결정만. 이번에 정할 치료가 선행인지 보조인지"},
        "setting.line_endocrine": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["1L", "2L", ">=3L", "not_applicable"]}}}],
                                   "description": "전이성만. 이번에 정할 고식적 내분비요법 차수 (심평원 투여단계). 간주 규칙은 반영하지 않는다 (deemed_lines로 따로)"},
        "setting.line_chemo": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["1L", "2L", ">=3L"]}}}],
                               "description": "전이성만. 이번에 정할 고식적 항암화학요법 차수. 간주 규칙은 반영하지 않는다"},
        "subtype": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["HR+/HER2-", "HR+/HER2+", "HR-/HER2+", "TNBC"]}}}]},
        "menopausal_status": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["premenopausal", "postmenopausal"]}}}],
                              "description": "peri는 premenopausal로 확정한다 (급여 2026-10-15 규칙, ESMO M01). 근거는 detail.basis"},
        "age_at_index": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"type": "integer", "minimum": 0}}}],
                         "description": "기준일 나이 (patient_state at_index.age). 급여 '40세 미만'에 쓴다"},
        "stage.t": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"type": "string", "pattern": "^(T0|Tis|T1mi|T1a|T1b|T1c|T1|T2|T3|T4a|T4b|T4c|T4d|T4|not_assessed)$"}}}],
                    "description": "pT 우선, 선행요법 전이면 cT. 선행요법을 받았으면 크기 조건은 선행 전 cT로 본다 (선행 후 값은 patient_state stage.yptnm). detail.basis에 p/c"},
        "stage.size_mm": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "not_recorded"}]}}}],
                          "description": "종양 최대 직경 (mm). 공고의 '1cm 이상·초과', '2cm 초과', '5cm 이상'을 T 범주 대신 mm로 판정한다. 수술 전·선행요법 환자는 임상 크기, 수술을 먼저 한 환자는 병리 크기 (patient_state clinical_size_mm·pathologic_size_mm). detail.basis에 c/p (2026-10-22 추가)"},
        "stage.positive_ln_count": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "not_recorded"}]}}}]},
        "stage.n": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["positive", "negative", "not_assessed"]}}}],
                    "description": "림프절 전이 여부 (공고 '림프절 양성'). 수술 전(선행요법 대상)은 cN, 수술 후는 pN. detail.basis에 c/p. N1mi는 positive, N0(i+)는 negative (2026-10-22 추가)"},
        "operable": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["yes", "no"]}}}],
                     "description": "수술 가능 여부 (patient_state stage.operable). 국소진행성의 선행요법 대상과 '절제 불가능' 고식 대상을 가른다 (공고 9장 1가, 2026-10-22 추가)"},
        "stage.group": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"type": "string", "pattern": "^(0|I|IA|IB|II|IIA|IIB|III|IIIA|IIIB|IIIC|IV)$"}}}]},
        "grade": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": [1, 2, 3, "not_recorded"]}}}]},
        "pcr": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["yes", "no", "not_applicable"]}}}],
                "description": "선행요법을 받지 않았으면 not_applicable"},
        "high_risk_early": {
          "allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {
            "type": "object",
            "required": ["hira", "esmo"],
            "additionalProperties": false,
            "properties": {
              "hira": {"enum": ["yes", "no", "unknown"], "description": "공고 9장 2 주2: 림프절 4개 이상, 또는 1~3개 + (T3 이상 또는 3등급)"},
              "esmo": {"enum": ["yes", "no", "unknown"], "description": "ESMO EBC 그림 5 (E08): 위 + Ki-67 20% 이상 (원문 기호 확인 필요)"}
            }
          }}}]
        },
        "endocrine_relapse_12m": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["yes", "no", "not_applicable"]}}}],
                                  "description": "보조 내분비요법 중 또는 종료 후 12개월 이내 재발 (patient_state deemed_lines DEEM-ENDO-ADJ-1Y). 보조 ET가 없거나 de novo 전이성이면 not_applicable"},
        "deemed_lines": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "DEEM-ANTHRA-TAXANE": {"enum": ["met", "not_met", "not_applicable"]},
            "DEEM-SG-1Y": {"enum": ["met", "not_met", "not_applicable"]},
            "DEEM-HER2ADC-6M": {"enum": ["met", "not_met", "not_applicable"]},
            "DEEM-ENDO-ADJ-1Y": {"enum": ["met", "not_met", "not_applicable"]}
          }
        }}}],
                         "description": "심평원 차수 간주 규칙 (patient_state fields.deemed_lines). D가 약제별로 차수 +1에 쓴다"},
        "dfi_days": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"oneOf": [{"type": "integer"}, {"const": "not_applicable"}]}}}],
                     "description": "무병 기간 = 첫 재발일 - 마지막 선행·보조 요법 종료일. 음수 = 투여 중 재발. de novo 전이성이면 not_applicable"},
        "recurrence_day": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "not_applicable"}]}}}],
                           "description": "첫 재발일 (국소·원격, 진단일 = 0. patient_state recurrence.recurrence_day). 약제별 '종료 후 n개월 이내 재발' 조건을 prior_regimens의 end_day와 비교한다. 재발이 없거나 de novo 전이성이면 not_applicable (2026-10-22 추가)"},
        "metastasis_day": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "not_applicable"}]}}}],
                           "description": "전이 기준일 (진단 시 IV기 = 0, 원격 재발 = 첫 원격 전이일. patient_state recurrence.metastasis_day). '보조 CDK4/6 종료 후 12개월 초과' 같은 조건. 전이성이 아니면 not_applicable (2026-10-22 추가)"},
        "anthracycline_cumulative": {
          "allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {
            "type": "object",
            "description": "약별 누적 투여량. anthracycline을 받은 약만 키를 둔다",
            "additionalProperties": false,
            "properties": {
              "doxorubicin": {"$ref": "#/$defs/cumulative_dose"},
              "epirubicin": {"$ref": "#/$defs/cumulative_dose"},
              "liposomal doxorubicin": {"$ref": "#/$defs/cumulative_dose"}
            }
          }}}],
          "description": "anthracycline 누적 용량 (patient_state anthracycline_drug_dose). liposomal doxorubicin 급여 조건 (공고 9장 4나-19, 약별로 따로 본다). 누적 용량 기준을 못 넘으면 cardiac_risk·mediastinal_radiation으로 판정한다 (2026-10-22 추가)"
        },
        "cardiac_risk": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["yes", "no"]}}}],
                         "description": "심장 위험요소·병력 (patient_state patient.cardiac_history, LVEF는 detail.lvef_percent). 공고 9장 4나-19 (2026-10-22 추가)"},
        "mediastinal_radiation": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["yes", "no"]}}}],
                                  "description": "종격동 방사선 치료 이력. 공고 9장 4나-19 (2026-10-22 추가)"},
        "visceral_crisis": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["yes", "no"]}}}],
                            "description": "장기 위기. yes면 ESMO M06·M50 (내분비 + CDK4/6 대신 항암). 전이성 결정에서 확인 (2026-10-22 추가)"},
        "contraindicated_classes": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"type": "array", "items": {"type": "string"}}}}],
                                    "description": "동반질환·전신 상태 때문에 쓰지 못하는 약 계열 (data/dictionaries/drug_classes.csv의 drug_subclass·drug_class, 예: CDK4/6_inhibitor, HER2-targeted Therapy). 없으면 빈 목록. ESMO M05·M35 (2026-10-22 추가)"},
        "metastatic_sites": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"type": "array", "items": {"type": "string"}}}}],
                             "description": "bone, liver, lung, brain, other: … (patient_state 표기)"},
        "bone_metastasis_imaging": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["yes", "no"]}}}],
                                    "description": "골전이가 영상으로 확인됐는지 (patient_state imaging_findings에 bone + confirmed). 골 보호제 급여 '영상으로 골전이 입증' (2026-10-22 추가)"},
        "recent_therapy_28d": {"allOf": [{"$ref": "#/$defs/item"}, {"properties": {"confirmed": {"enum": ["yes", "no"]}}}],
