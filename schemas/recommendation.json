{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendation.json",
  "title": "recommendation",
  "description": "[4] LLM 추천 모듈(B)의 최종 출력. 모든 추천 문장과 급여 분류에 청크 ID를 인용한다. 초안 v0.1-draft.",
  "type": "object",
  "required": ["schema_version", "patient_ref", "generated_at", "model", "options", "tests_needed", "out_of_scope", "conflicts", "index_status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1-draft"},
    "patient_ref": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "model": {"type": "string", "description": "사용한 로컬 모델 이름"},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["therapy", "rationale", "citations", "reimbursement", "reimbursement_reason", "reimbursement_citations"],
        "additionalProperties": false,
        "properties": {
          "therapy": {"type": "string"},
          "drugs": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"},
          "evidence": {"type": ["string", "null"], "description": "예: LoE I, GoR A"},
          "guideline_source": {"enum": ["ESMO", "ASCO", null], "description": "ESMO와 ASCO는 합치지 않고 출처별로 따로 낸다."},
          "citations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "지침 청크 ID"},
          "reimbursement": {"enum": ["covered", "covered_conditions_unverified", "offlabel_approved", "no_criteria"]},
          "reimbursement_reason": {"type": "string", "description": "충족한 조건 또는 빠진 조건"},
          "reimbursement_citations": {"type": "array", "items": {"type": "string"}, "description": "급여 청크 ID. no_criteria면 빈 배열 가능"},
          "copay": {"type": ["string", "null"], "description": "허가초과 인정일 때 본인부담률"},
          "pending_notices": {
            "type": "array",
            "description": "회색 태그로 표시하는 예정·진행중 공고",
            "items": {
              "type": "object",
              "required": ["status", "title", "date", "url"],
              "additionalProperties": false,
              "properties": {
                "status": {"enum": ["scheduled", "in_progress"]},
                "title": {"type": "string"},
                "date": {"type": "string", "format": "date"},
                "url": {"type": "string"}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"reimbursement": {"enum": ["covered", "covered_conditions_unverified", "offlabel_approved"]}}},
            "then": {"properties": {"reimbursement_citations": {"minItems": 1}}}
          }
        ]
      }
    },
    "tests_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "reason"],
        "additionalProperties": false,
        "properties": {
          "test": {"type": "string"},
          "reason": {"type": "string"},
          "blocks_therapy": {"type": ["string", "null"], "description": "이 검사가 없어 추천 대신 검사 권고로 바꾼 치료"}
        }
      }
    },
    "out_of_scope": {"type": "boolean"},
    "out_of_scope_reason": {"type": ["string", "null"], "description": "예: DCIS, 남성 유방암, 검색 결과 없음"},
    "conflicts": {"type": "array", "items": {"type": "string"}, "description": "예: ESMO와 ASCO 권고 차수가 다름"},
    "index_status": {
      "type": "object",
      "description": "화면 하단 한 줄 요약 (D 제공)",
      "required": ["booklet_date", "overlay_notices", "scheduled_count", "in_progress_count"],
      "additionalProperties": false,
      "properties": {
        "booklet_date": {"type": "string", "format": "date"},
        "overlay_notices": {"type": "array", "items": {"type": "string"}},
        "scheduled_count": {"type": "integer", "minimum": 0},
        "in_progress_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
