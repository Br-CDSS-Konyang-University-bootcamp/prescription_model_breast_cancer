{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patient_state.json",
  "title": "patient_state",
  "description": "[1] 입력 모듈(A)의 출력. 비식별화된 차트에서 추출한 환자 상태. 모든 값에 원문 근거 위치를 붙인다. 초안 v0.1-draft.",
  "type": "object",
  "required": ["schema_version", "patient_ref", "created_at", "documents", "fields", "conflicts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1-draft"},
    "patient_ref": {"type": "string", "description": "가명 ID. 실제 이름·등록번호를 넣지 않는다."},
    "created_at": {"type": "string", "format": "date-time"},
    "documents": {
      "type": "array",
      "description": "IN-1 문서 분류 결과",
      "items": {
        "type": "object",
        "required": ["doc_id", "doc_type"],
        "additionalProperties": false,
        "properties": {
          "doc_id": {"type": "string"},
          "doc_type": {"enum": ["progress_note", "pathology", "molecular", "medication"]},
          "doc_date": {"type": ["string", "null"], "format": "date"}
        }
      }
    },
    "fields": {
      "type": "object",
      "description": "PROJECT.md §4 추출 스키마",
      "required": ["diagnosis", "stage", "receptors", "proliferation", "patient", "treatment_history", "neoadjuvant_response", "recurrence", "genomic_reports"],
      "additionalProperties": false,
      "properties": {
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "diagnosis_date": {"$ref": "#/$defs/extracted"},
            "histology": {"$ref": "#/$defs/extracted"},
            "grade": {"$ref": "#/$defs/extracted"}
          }
        },
        "stage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ctnm": {"$ref": "#/$defs/extracted"},
            "ptnm": {"$ref": "#/$defs/extracted"},
            "metastatic_sites": {"$ref": "#/$defs/extracted"}
          }
        },
        "receptors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "er_percent": {"$ref": "#/$defs/extracted"},
            "pr_percent": {"$ref": "#/$defs/extracted"},
            "her2_ihc": {"$ref": "#/$defs/extracted"},
            "her2_ish": {"$ref": "#/$defs/extracted"}
          }
        },
        "proliferation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ki67_percent": {"$ref": "#/$defs/extracted"}
          }
        },
        "patient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "age": {"$ref": "#/$defs/extracted"},
            "menopausal_status": {"$ref": "#/$defs/extracted"},
            "ecog": {"$ref": "#/$defs/extracted"}
          }
        },
        "treatment_history": {
          "type": "array",
          "description": "치료 이력. 시간순.",
          "items": {
            "type": "object",
            "required": ["drugs", "source"],
            "additionalProperties": false,
            "properties": {
              "drugs": {"type": "array", "items": {"type": "string"}, "description": "일반명으로 정규화 (IN-3)"},
              "setting": {"enum": ["neoadjuvant", "adjuvant", "metastatic", "unknown"]},
              "start_date": {"type": ["string", "null"], "format": "date"},
              "end_date": {"type": ["string", "null"], "format": "date"},
              "stop_reason": {"type": ["string", "null"], "description": "예: 진행, 독성, 완료"},
              "best_response": {"enum": ["CR", "PR", "SD", "PD", "unknown", null]},
              "source": {"$ref": "#/$defs/source"}
            }
          }
        },
        "neoadjuvant_response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pcr": {"$ref": "#/$defs/extracted"},
            "rcb": {"$ref": "#/$defs/extracted"}
          }
        },
        "recurrence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recurrence_date": {"$ref": "#/$defs/extracted"},
            "adjuvant_endocrine_end_date": {"$ref": "#/$defs/extracted"}
          }
        },
        "genomic_reports": {
          "type": "array",
          "description": "IN-7. 분자병리·NGS 보고서 원문을 해석하지 않고 B에게 넘긴다.",
          "items": {
            "type": "object",
            "required": ["doc_id", "raw_text"],
            "additionalProperties": false,
            "properties": {
              "doc_id": {"type": "string"},
              "report_date": {"type": ["string", "null"], "format": "date"},
              "specimen": {"type": ["string", "null"], "description": "예: 원발 조직, 전이 병소, cfDNA"},
              "raw_text": {"type": "string"}
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "IN-5. 같은 시점에 값이 다른 경우. 자동 선택하지 않고 확인을 요청한다.",
      "items": {
        "type": "object",
        "required": ["field", "candidates"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string", "description": "예: receptors.her2_ihc"},
          "candidates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/extracted"}},
          "note": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "description": "원문 근거 위치",
      "required": ["doc_id", "quote"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {"type": "string"},
        "quote": {"type": "string", "description": "원문 인용 (비식별화된 텍스트)"},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 0}
      }
    },
    "extracted": {
      "type": "object",
      "description": "추출된 값 하나. IN-6 상태: present(값 있음) / not_done(미시행) / not_recorded(기록 없음).",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["present", "not_done", "not_recorded"]},
        "value": {"description": "정규화된 값 (IN-3). status가 present일 때만 채운다."},
        "raw": {"type": ["string", "null"], "description": "정규화 전 원문 표기"},
        "observed_date": {"type": ["string", "null"], "format": "date", "description": "검사일 또는 기록일 (IN-4 시간 정렬 기준)"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]}
      },
      "if": {"properties": {"status": {"const": "present"}}},
      "then": {"required": ["value", "source"]}
    }
  }
}
