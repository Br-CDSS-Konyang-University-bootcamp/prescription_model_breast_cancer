{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patient_state.json",
  "title": "patient_state",
  "description": "[1] 입력 모듈(A)의 출력. 비식별화된 차트에서 추출한 환자 상태. 모든 값에 원문 근거 위치를 붙인다. 필드 설명은 src/input/schema_fields.md. 초안 v0.1-draft6 (2026-10-16, 판정 기준일 index_day, 첫 재발일 recurrence_day, 투약별 차수 line·endocrine_line·chemo_line, 심평원 차수 간주 규칙 deemed_lines 추가. draft5는 2026-10-15: 진단일 기준 일수, 투여 주기, 재발·전이 정보, PD-L1, 유전자 변이, anthracycline 투약 용량). 상대 일수(*_day)는 진단일 = 0인 정수다. 실제 날짜가 아니므로 TCGA 정답에도 넣는다.",
  "type": "object",
  "required": ["schema_version", "patient_ref", "created_at", "documents", "fields", "conflicts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1-draft6"},
    "patient_ref": {"type": "string", "description": "가명 ID. 실제 이름·등록번호를 넣지 않는다."},
    "created_at": {"type": "string", "format": "date-time"},
    "index_day": {"$ref": "#/$defs/day", "description": "판정 기준일 (진단일 = 0). 추천과 급여 판정을 하는 '지금' 시점. '최근 4주 이내 투여', 투여 시점 나이 같은 조건에 쓴다. TCGA는 마지막 추적일(fu_last_days)"},
    "documents": {
      "type": "array",
      "description": "IN-1 문서 분류 결과",
      "items": {
        "type": "object",
        "required": ["doc_id", "doc_type"],
        "additionalProperties": false,
        "properties": {
          "doc_id": {"type": "string"},
          "doc_type": {"enum": ["progress_note", "pathology", "molecular", "medication"]},
          "doc_date": {"$ref": "#/$defs/date"}
        }
      }
    },
    "fields": {
      "type": "object",
      "description": "PROJECT.md §4 추출 스키마",
      "required": ["diagnosis", "stage", "receptors", "proliferation", "patient", "treatment_history", "anthracycline_drug_dose", "neoadjuvant_response", "recurrence", "molecular", "genomic_reports"],
      "additionalProperties": false,
      "properties": {
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "diagnosis_date": {"$ref": "#/$defs/date_field"},
            "histology": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"enum": ["IDC", "ILC", "mucinous", "metaplastic", "invasive_NOS", "other"]}}}]},
            "grade": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"enum": [1, 2, 3]}}}]}
          }
        },
        "stage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ctnm": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/tnm_value"}}}]},
            "ptnm": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/tnm_value"}}}]},
            "group": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "type": "string",
              "pattern": "^((0|I{1,3}|IV)[A-C]?|not_assessed)$",
              "description": "병기군. 예: IIA, IIIC, IV. Stage X → not_assessed"}}}]},
            "positive_ln_count": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "type": "object",
              "required": ["positive", "examined"],
              "additionalProperties": false,
              "properties": {
                "positive": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "[Not Available]"}]},
                "examined": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "[Not Available]"}]}
              }}}}]},
            "disease_extent": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "enum": ["early", "locally_advanced", "metastatic"],
              "description": "진단 시 병기 범주 (IN-3). I~II → early(조기), III → locally_advanced(국소 진행성, 심평원 급여 조건의 3기), IV → metastatic(전이성). 병기군이 없으면 TNM으로 정한다 (M1 → metastatic, M0·MX이면서 T4 또는 N2~3 → locally_advanced). 재발 후 상태는 biomarker_record.setting.disease"}}}]},
            "metastatic_sites": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/sites_value"}}}]},
            "operable": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "enum": ["yes", "no", "unknown"],
              "description": "수술 가능 여부. 국소진행성이 선행요법 대상인지 고식적요법 대상인지 가른다 (공고 p.63 '절제 불가능'). TCGA에는 없음"}}}]}
          }
        },
        "receptors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "er_percent": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/er_value"}}}]},
            "pr_percent": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/pr_value"}}}]},
            "her2_ihc": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/her2_ihc_value"}}}]},
            "her2_ish": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "type": "object",
              "required": ["result"],
              "additionalProperties": false,
              "properties": {
                "result": {"enum": ["amplified", "not_amplified", "equivocal"]},
                "method": {"enum": ["FISH", "SISH", "DISH", "unknown"]}
              }}}}]},
            "pdl1": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/pdl1_value"}}}]}
          }
        },
        "proliferation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ki67_percent": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "percent": {"type": "number", "minimum": 0, "maximum": 100},
                "range": {"$ref": "#/$defs/range"},
                "result": {"enum": ["low", "intermediate", "high"]}
              }}}}]}
          }
        },
        "patient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gender": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"enum": ["FEMALE", "MALE"]}}}]},
            "age": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"type": "integer", "minimum": 0}}}]},
            "menopausal_status": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"enum": ["premenopausal", "perimenopausal", "postmenopausal", "indeterminate"]}}}]},
            "menopausal_basis": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "enum": ["age_amenorrhea", "fsh", "oophorectomy", "unknown"],
              "description": "폐경 판정 근거 (공고 p.48 폐경 정의). age_amenorrhea = 나이와 무월경 기간, fsh = 혈중 FSH 농도, oophorectomy = 양측 난소절제. TCGA에는 없음"}}}]},
            "ecog": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"enum": [0, 1, 2, 3, 4]}}}]}
          }
        },
        "treatment_history": {
          "type": "array",
          "description": "치료 이력. 시간순. 항목 하나 = 요법 하나.",
          "items": {
            "type": "object",
            "required": ["drugs"],
            "additionalProperties": false,
            "properties": {
              "drugs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "일반명 소문자 (IN-3)"},
              "setting": {"enum": ["neoadjuvant", "adjuvant", "metastatic", "unknown"]},
              "start_date": {"$ref": "#/$defs/date"},
              "end_date": {"$ref": "#/$defs/date"},
              "duration_days": {"type": ["integer", "null"], "minimum": 0, "description": "투여일. TCGA 정답에서는 d종료 − d시작"},
              "start_day": {"$ref": "#/$defs/day", "description": "투약 시작일 (진단일 = 0). TCGA는 크롭본 drug_start_days (원본 pharmaceutical_tx_started_days_to)"},
              "end_day": {"$ref": "#/$defs/day", "description": "투약 종료일 (진단일 = 0). TCGA는 크롭본 drug_end_days (원본 pharmaceutical_tx_ended_days_to), 기록이 없으면 null"},
              "progression_day": {"$ref": "#/$defs/day", "description": "이 요법 중 또는 후 진행일 (공고 p.57 '종료 후 1달 이내 진행'). TCGA에는 없음"},
              "cycles": {
                "anyOf": [
                  {"$ref": "#/$defs/cycles_value"},
                  {"type": "null"}
                ],
                "description": "투여 주기 수 (trastuzumab 18주기, T-DM1 14주기 등 급여 조건). 매일 먹는 약(내분비요법 경구제 등)은 null"},
              "stop_reason": {"enum": ["progression", "toxicity", "completed", "planned_switch", "maintenance", "other", null], "description": "planned_switch = 계획된 순차 요법(AC→T 등), maintenance = 유지요법 전환. 둘 다 같은 차수로 센다"},
              "best_response": {"enum": ["CR", "PR", "SD", "PD", "unknown", null]},
              "line": {"type": ["integer", "null"], "minimum": 1, "description": "전이 후 전체 차수 (지침용, 간주 규칙 없음). 전이 전 투약·보조약·골 보호제는 null. 계산 규칙은 src/input/common/lines.py, handoff_to_B.md §6.2"},
              "endocrine_line": {"type": ["integer", "null"], "minimum": 1, "description": "고식적 내분비요법 차수 (심평원 투여단계, 간주 규칙 없음). 이 투약이 내분비요법이 아니면 null"},
              "chemo_line": {"type": ["integer", "null"], "minimum": 1, "description": "고식적 항암화학요법 차수 (심평원 투여단계, 간주 규칙 없음). 항암·HER2 표적·면역항암제가 들어간 요법. 이 투약이 항암이 아니면 null"},
              "source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]}
            }
          }
        },
        "deemed_lines": {
          "type": "array",
          "description": "심평원 차수 간주 규칙 판정 (공고 p.57, 61~63). 선행·보조요법을 고식적 요법 1회로 간주할지 규칙마다 따로 판정한다. 급여 판정은 '실제 차수(line·endocrine_line·chemo_line) + 해당 규칙이 met이면 1'로 투여단계와 비교한다. 규칙 4개를 항상 모두 적는다",
          "items": {
            "type": "object",
            "required": ["rule_id", "category", "status", "basis", "regimen_refs", "gap_days", "notice_page"],
            "additionalProperties": false,
            "properties": {
              "rule_id": {"enum": ["DEEM-ANTHRA-TAXANE", "DEEM-SG-1Y", "DEEM-HER2ADC-6M", "DEEM-ENDO-ADJ-1Y"],
                "description": "DEEM-ANTHRA-TAXANE = anthracycline·taxane 포함 선행·보조요법은 기간 제한 없이 항암 1차로 간주 (p.61~62). DEEM-SG-1Y = 선행·보조요법 중·종료 후 1년 이내 재발이면 항암 1차로 간주 (sacituzumab govitecan, p.63). DEEM-HER2ADC-6M = trastuzumab 포함 보조요법 중·종료 후 6개월 이내 재발이면 trastuzumab 실패로 인정 (T-DM1·T-DXd, p.62~63). DEEM-ENDO-ADJ-1Y = 보조 내분비요법 중·종료 후 1년 이내 재발이면 '내분비요법 후 진행'으로 인정 (p.57)"},
              "category": {"enum": ["chemo", "endocrine"], "description": "올리는 차수: chemo = chemo_line, endocrine = endocrine_line"},
              "status": {"enum": ["met", "not_met", "unknown", "not_applicable"], "description": "unknown = 종료일·재발일이 없어 판정할 수 없음. not_applicable = 전이성이 아님 (전이 기준일 없음)"},
              "basis": {"type": "string", "description": "판정 이유 (근거 투약과 일수)"},
              "regimen_refs": {"type": "array", "items": {"type": "integer", "minimum": 0}, "description": "근거가 된 treatment_history 순번 (0부터)"},
              "gap_days": {"type": ["integer", "null"], "description": "근거 투약 종료일부터 전이 기준일까지 일수. 음수면 투여 중에 전이. 종료일이 없으면 시작일 기준. 기간 조건이 없거나 계산할 수 없으면 null"},
              "notice_page": {"type": "string", "description": "공고책자 쪽 (2026-10-01판)"}
            }
          }
        },
        "anthracycline_drug_dose": {
          "type": "object",
          "description": "anthracycline 투약 용량 (공고 p.60 liposomal doxorubicin 조건: doxorubicin 누적 240mg/m2 이상 또는 epirubicin 450mg/m2 이상). 대상 약: doxorubicin, epirubicin, liposomal doxorubicin (mitoxantrone 제외). TCGA는 drug_timeline 항목 순서로 용량 열을 맞추고, 병용 기록은 '+' 위치로 나눈다. 값이 없으면 'No value'",
          "required": ["administered", "drugs"],
          "additionalProperties": false,
          "properties": {
            "administered": {"enum": ["positive", "negative", "No value"], "description": "positive = anthracycline 투약 항목 있음, negative = 투약 기록은 있으나 anthracycline 없음, No value = 투약 기록 자체가 없음"},
            "drugs": {
              "type": "array",
              "description": "anthracycline 투약 항목 하나 = 원소 하나. administered가 positive가 아니면 빈 배열",
              "items": {
                "type": "object",
                "required": ["drug", "dose_per_admin", "cycles", "total_dose"],
                "additionalProperties": false,
                "properties": {
                  "drug": {"enum": ["doxorubicin", "epirubicin", "liposomal doxorubicin"]},
                  "timeline_index": {"type": ["integer", "null"], "minimum": 0, "description": "TCGA drug_timeline에서 몇 번째 항목인지 (0부터). 차트에서는 null"},
                  "combined_with": {"type": "array", "items": {"type": "string"}, "description": "같은 기록에 함께 적힌 약 (예: AC의 cyclophosphamide)"},
                  "dose_per_admin": {"$ref": "#/$defs/dose_or_novalue", "description": "1회 용량. TCGA drug_prescribed_dose + drug_dose_units"},
                  "cycles": {"anyOf": [{"$ref": "#/$defs/cycles_value"}, {"const": "No value"}], "description": "주기 수 기록값만 (basis는 항상 recorded, 추정하지 않음). TCGA drug_cycles"},
                  "total_dose": {"$ref": "#/$defs/dose_or_novalue", "description": "총 투여량. TCGA drug_total_dose + drug_total_dose_units"},
                  "raw": {"type": ["string", "null"], "description": "원문. TCGA는 drug_timeline 해당 항목"},
                  "source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]}
                }
              }
            }
          }
        },
        "neoadjuvant_response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pcr": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"enum": ["yes", "no"]}}}]},
            "rcb": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"enum": ["RCB-0", "RCB-I", "RCB-II", "RCB-III"]}}}]}
          }
        },
        "recurrence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recurrence_date": {"$ref": "#/$defs/date_field"},
            "adjuvant_endocrine_end_date": {"$ref": "#/$defs/date_field"},
            "status": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "enum": ["none", "distant", "locoregional", "site_unknown", "unknown"],
              "description": "재발 상태. TCGA는 recurrence_status. 국소 재발은 전이가 아니다"}}}]},
            "metastatic_sites": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/sites_value"}}}],
              "description": "재발로 생긴 전이 부위. 여러 개 나열. TCGA는 nte_sites + nte_sites_other (국소 부위가 섞일 수 있음)"},
            "metastasis_day": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"type": "integer", "minimum": 0}}}],
              "description": "전이 기준일 (진단일 = 0). 진단 시 IV기 = 0, 원격 전이 재발 = 첫 원격 전이 진단일. A가 treatment_history[].start_day와 비교해 차수를 정한다. TCGA는 metastasis_dx_days"},
            "recurrence_day": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"type": "integer", "minimum": 0}}}],
              "description": "첫 재발일 (진단일 = 0). 국소·원격 재발 모두. 진단 시 IV기는 재발이 아니므로 넣지 않는다. '보조요법 종료 후 1년 이내 재발' 같은 급여 조건에 쓴다. TCGA는 locoregional_dx_days, metastasis_dx_days(원격 전이 재발일 때) 중 이른 값"},
            "surgery": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "enum": ["yes", "no", "unknown"],
              "description": "재발 후 수술 여부. TCGA는 nte_surgery (YES가 하나라도 있으면 yes)"}}}]},
            "surgery_intent": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "enum": ["curative", "palliative", "unknown"],
              "description": "재발 후 수술 의도. TCGA는 기록이 없어 모두 unknown"}}}]},
            "later_distant": {"allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {
              "enum": ["yes", "no", "unknown"],
              "description": "국소 재발 이후 원격 전이 여부. status = locoregional, surgery = yes, later_distant = no이면 이후 요법은 수술후보조요법 (공고 p.48, B 규칙)"}}}]}
          }
        },
        "molecular": {
          "type": "object",
          "description": "유전자 변이. 유전자마다 칸을 따로 둔다. gBRCA 판정(positive / negative / vus)은 B가 BRCA1·BRCA2 값을 받아 정한다 (TCGA 정답은 체세포 엑솜 결과를 gBRCA 측정으로 가정)",
          "additionalProperties": false,
          "properties": {
            "mutations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ESR1": {"$ref": "#/$defs/gene_field"},
                "PIK3CA": {"$ref": "#/$defs/gene_field"},
                "AKT1": {"$ref": "#/$defs/gene_field"},
                "PTEN": {"$ref": "#/$defs/gene_field"},
                "BRCA1": {"$ref": "#/$defs/gene_field"},
                "BRCA2": {"$ref": "#/$defs/gene_field"},
                "PALB2": {"$ref": "#/$defs/gene_field"}
              }
            }
          }
        },
        "genomic_reports": {
          "type": "array",
          "description": "IN-7. 분자병리·NGS 보고서 원문을 해석하지 않고 B에게 넘긴다.",
          "items": {
            "type": "object",
            "required": ["doc_id", "raw_text"],
            "additionalProperties": false,
            "properties": {
              "doc_id": {"type": "string"},
              "report_date": {"$ref": "#/$defs/date"},
              "specimen": {"$ref": "#/$defs/specimen"},
              "raw_text": {"type": "string"}
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "IN-5. 같은 시점에 값이 다른 경우. 자동 선택하지 않고 확인을 요청한다.",
      "items": {
        "type": "object",
        "required": ["field", "candidates"],
        "additionalProperties": false,
        "properties": {
          "field": {"type": "string", "description": "예: receptors.her2_ihc"},
          "candidates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/extracted"}},
          "note": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "date": {
      "description": "날짜. 전체 날짜(YYYY-MM-DD) 또는 부분 날짜(YYYY-MM, YYYY). 모르면 null. TCGA 정답은 모든 날짜가 null.",
      "anyOf": [
        {"type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"},
        {"type": "null"}
      ]
    },
    "date_field": {
      "allOf": [{"$ref": "#/$defs/extracted"}, {"properties": {"value": {"$ref": "#/$defs/date"}}}]
    },
    "day": {
      "type": ["integer", "null"],
      "description": "진단일 기준 일수 (진단일 = 0, 진단 전이면 음수). 모르면 null"
    },
    "sites_value": {
      "anyOf": [
        {"type": "array", "items": {"type": "string"}, "description": "bone, liver, lung, brain, distant_ln, skin, other: <자유 기재>. 여러 개 나열"},
        {"enum": ["[Not Applicable]", "[Not Available]"]}
      ]
    },
    "cycles_value": {
      "type": "object",
      "description": "주기 수와 주기 길이(단위). 같은 '18주기'라도 3주 주기와 매주 투여는 기간이 다르다",
      "required": ["value", "basis", "interval_days", "interval_basis"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "integer", "minimum": 0},
        "basis": {"enum": ["recorded", "estimated"], "description": "recorded = 기록값 (TCGA drug_cycles), estimated = 투여 일수 ÷ 주기 길이 + 1"},
        "interval_days": {"type": ["integer", "null"], "minimum": 1, "description": "주기 길이 (일). 예: 21 = 3주, 7 = 매주"},
        "interval_basis": {"enum": ["recorded", "derived", "standard", null], "description": "recorded = 차트에 적힘, derived = 투여 일수 ÷ (기록 주기 수 − 1), standard = 약제별 기본값 (data/dictionaries/drug_classes.csv의 cycle_days)"}
      }
    },
    "dose_or_novalue": {
      "anyOf": [
        {"type": "object", "required": ["value", "unit"], "additionalProperties": false, "properties": {
          "value": {"type": "number", "minimum": 0, "description": "용량. 원문이 범위(예: 100-102)면 최대값"},
          "unit": {"type": "string", "description": "원문 단위 그대로 (mg, mg/m2, mg/day 등). TCGA에는 키·몸무게가 없어 mg/m2로 바꾸지 않는다"}}},
        {"const": "No value"}
      ]
    },
    "pdl1_value": {
      "type": "object",
      "description": "PD-L1 발현 (면역염색). 변이가 아니라 발현 점수다. 약마다 검사법과 기준이 달라 A는 판정하지 않고 B가 정한다 (pembrolizumab: 22C3 CPS ≥ 10, 공고 p.58~59 / atezolizumab: SP142 IC ≥ 1%, ESMO)",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "assay": {"enum": ["22C3", "SP142", "SP263", "other", "unknown"]},
        "score_type": {"enum": ["CPS", "IC", "TPS", "unknown"]},
        "score": {"type": "number", "minimum": 0}
      }
    },
    "variant": {
      "type": "object",
      "required": ["raw"],
      "additionalProperties": false,
      "properties": {
        "protein_change": {"type": ["string", "null"], "description": "예: H1047R, Q934*, X27_splice"},
        "variant_type": {"type": ["string", "null"], "description": "예: Missense_Mutation, Nonsense_Mutation, Frame_Shift_Del"},
        "vaf": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "raw": {"type": "string", "description": "원문. TCGA는 mut_* 값 그대로 (예: 'H1047R (Missense_Mutation, VAF 0.31)')"}
      }
    },
    "gene_field": {
      "type": "object",
      "description": "유전자 하나의 변이 결과. 변이 있음 = status present + result detected, 변이 없음 = status present + result not_detected, 미시행 = status not_done. TCGA: mut_* 값이 변이 표기면 detected, '변이 없음'이면 not_detected, 빈 값이면 not_done",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["present", "not_done", "not_recorded"]},
        "result": {"enum": ["detected", "not_detected"]},
        "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
        "specimen": {"$ref": "#/$defs/specimen"},
        "source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "present"}}}, "then": {"required": ["result", "variants"]}},
        {"if": {"properties": {"result": {"const": "detected"}}, "required": ["result"]}, "then": {"properties": {"variants": {"minItems": 1}}}},
        {"if": {"properties": {"result": {"const": "not_detected"}}, "required": ["result"]}, "then": {"properties": {"variants": {"maxItems": 0}}}}
      ]
    },
    "specimen": {"enum": ["primary", "metastasis", "cfDNA", "unknown", null]},
    "range": {
      "type": "array",
      "prefixItems": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "number", "minimum": 0, "maximum": 100}],
      "minItems": 2,
      "maxItems": 2,
      "description": "[최소, 최대]. 예: 90-99% → [90, 99], 1-9% → [1, 9], <1% → [0, 0]"
    },
    "allred": {
      "type": "object",
      "description": "Allred 점수. 적힌 것만 넣는다. total = ps + is (0, 2~8). ps = 비율 점수 (0 없음, 1 <1%, 2 1~10%, 3 11~33%, 4 34~66%, 5 ≥67%), is = 강도 점수 (0~3).",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 0, "maximum": 8},
        "ps": {"type": "integer", "minimum": 0, "maximum": 5},
        "is": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "er_value": {
      "type": "object",
      "description": "ER. 있는 것을 모두 담는다 (A 결정). ER·PR에는 강도 점수(score) 키를 두지 않는다 (2026-10-15 결정): Allred 총점은 allred.total, 강도는 allred.is만 쓴다.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "percent": {"type": "number", "minimum": 0, "maximum": 100},
        "range": {"$ref": "#/$defs/range"},
        "allred": {"$ref": "#/$defs/allred"},
        "result": {"enum": ["positive", "low_positive", "negative", "indeterminate"], "description": "low_positive는 ER에만 있다 (ASCO/CAP 2020 ER Low Positive)"}
      }
    },
    "pr_value": {
      "type": "object",
      "description": "PR. ER과 같은 형태지만 저발현 범주가 없다 (ASCO/CAP Low Positive는 ER만 해당). score 키는 없다 (2026-10-15).",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "percent": {"type": "number", "minimum": 0, "maximum": 100},
        "range": {"$ref": "#/$defs/range"},
        "allred": {"$ref": "#/$defs/allred"},
        "result": {"enum": ["positive", "negative", "indeterminate"]}
      }
    },
    "her2_ihc_value": {
      "type": "object",
      "description": "HER2 IHC. score와 result를 있는 것 모두 담는다. result는 ISH로 보정한 값이므로 B는 score를 먼저 읽는다 (A 결정).",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "score": {"enum": ["0", "1+", "2+", "3+"]},
        "faint": {"type": "boolean", "description": "IHC 0이면서 10% 이하 세포에 희미한 불완전 막 염색이 있으면 true. B는 score 0 + faint true를 HER2 초저발현(ultralow)으로 판정한다"},
        "result": {"enum": ["positive", "negative", "equivocal", "indeterminate", "unknown"]}
      }
    },
    "tnm_value": {
      "type": "object",
      "required": ["t", "n", "m"],
      "additionalProperties": false,
      "properties": {
        "t": {"type": "string", "description": "예: T2, T1c, T4b. TX → not_assessed"},
        "n": {"type": "string", "description": "예: N1a, N0(i+), N1mi. NX → not_assessed"},
        "m": {"type": "string", "description": "예: M0, M1, cM0(i+). MX → not_assessed"},
        "edition": {"type": ["string", "null"], "description": "AJCC 판. 예: 7th, 8th"}
      }
    },
    "source": {
      "type": "object",
      "description": "원문 근거 위치",
      "required": ["doc_id", "quote"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {"type": "string"},
        "quote": {"type": "string", "description": "원문 인용 (비식별화된 텍스트)"},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 0}
      }
    },
    "history_item": {
      "type": "object",
      "description": "새 결과에 밀려난 이전 값 (참고용)",
      "required": ["status", "superseded_reason"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["present", "not_done", "not_recorded"]},
        "value": {},
        "raw": {"type": ["string", "null"]},
        "observed_date": {"$ref": "#/$defs/date"},
        "specimen": {"$ref": "#/$defs/specimen"},
        "source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}]},
        "superseded_reason": {"enum": ["recurrence", "newer_result"], "description": "recurrence = 재발 병소 재생검 결과로 대체, newer_result = 같은 검체의 더 최근 결과로 대체"}
      }
    },
    "extracted": {
      "type": "object",
      "description": "추출된 값 하나. status: present(값 있음) / not_done(미시행) / not_recorded(기록 없음).",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["present", "not_done", "not_recorded"]},
        "value": {"description": "표준값. 형태는 필드마다 다르다. status가 present일 때만 채운다."},
        "raw": {"type": ["string", "null"], "description": "정규화 전 원문 표기"},
        "observed_date": {"$ref": "#/$defs/date"},
        "specimen": {"$ref": "#/$defs/specimen"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "source": {"anyOf": [{"$ref": "#/$defs/source"}, {"type": "null"}], "description": "TCGA 정답 생성 1단계에서는 null, 가상 차트 생성 후 채운다"},
        "history": {"type": "array", "items": {"$ref": "#/$defs/history_item"}}
      },
      "if": {"properties": {"status": {"const": "present"}}},
      "then": {"required": ["value"]}
    }
  }
}
